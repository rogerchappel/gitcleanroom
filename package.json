{
  "name": "gitcleanroom",
  "version": "0.1.0",
  "description": "Safe git worktree cleanroom helper for risky agent edits.",
  "type": "module",
  "bin": {
    "gitcleanroom": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test --test-reporter=spec dist/open.test.js dist/status.test.js",
    "smoke": "npm run build && bash scripts/smoke.sh",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm test && npm run check && npm run build && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "git",
    "worktree",
    "cli",
    "agent",
    "cleanroom",
    "developer-tools"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/gitcleanroom.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/gitcleanroom/issues"
  },
  "homepage": "https://github.com/rogerchappel/gitcleanroom#readme"
}
